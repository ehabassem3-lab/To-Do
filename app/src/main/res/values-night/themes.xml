<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ToDo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary"></item>
    </style>



    <style name="titleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="titleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="titleSmall">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/Light_Blue</item>
    </style>
    <style name="bodyLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textColor">@color/grey</item>
    </style>
    <style name="bodyMedium">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="bodySmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="RoundFab">
        <item name="cornerSize">50%</item>
        <item name="color">@color/white</item>
    </style>
    <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/back_ground_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_insets</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <!-- THIS is very important -->
        <item name="postSplashScreenTheme">@style/Theme.ToDo</item>
    </style>
</resources>